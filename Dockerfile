# Stage 1: Install dependencies
FROM oven/bun:1.3.11-alpine AS deps

WORKDIR /app

# `patches/` is required up front: package.json declares patchedDependencies,
# which bun applies during install.
COPY package.json bun.lock ./
COPY patches ./patches

RUN bun install --frozen-lockfile

# Stage 2: Build the application
FROM oven/bun:1.3.11-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json bun.lock ./
COPY next.config.mjs tsconfig.json postcss.config.mjs proxy.ts ./
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY content ./content

ENV NEXT_TELEMETRY_DISABLED=1

# .source/ is generated by the fumadocs-mdx macro during `next build`,
# so there is no separate codegen step.
RUN bun run build

# Stage 3: Production runner
FROM node:22-alpine AS runner

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
